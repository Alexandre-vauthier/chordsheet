rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Fichiers audio déposés pour l'analyse : chaque utilisateur écrit/lit
    // uniquement dans son propre dossier. Fichiers temporaires (analyse ponctuelle).
    match /analyze-uploads/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 30 * 1024 * 1024;
    }
  }
}
