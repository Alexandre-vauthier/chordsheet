rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper : vérifier si l'utilisateur est admin
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper : vérifier si l'utilisateur est membre d'un groupe
    function isGroupMember(groupId) {
      return request.auth != null &&
             request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // Helper : vérifier si l'utilisateur a un abonnement Pro actif
    function isProUser() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/subscription) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)/private/subscription).data.plan == 'pro' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)/private/subscription).data.status in ['active', 'trialing'];
    }

    // Utilisateurs - lecture/écriture pour soi-même, lecture complète pour admin
    // (le profil ne contient plus de données de facturation, voir /private/subscription)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Données privées (abonnement Stripe) - accessibles uniquement au titulaire ou à un admin
      match /private/{docId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    /**
     * Accords absents de la bibliothèque, mémoire des annonces déjà faites.
     *
     * Écriture réservée au serveur : l'Admin SDK ne passe pas par ces règles, et
     * personne d'autre n'a de raison de toucher cette table. Sans ce verrou, un
     * compte pourrait effacer la mémoire et faire ré-annoncer les mêmes accords.
     */
    match /unknown_chords/{chordId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Grilles d'accords
    match /sheets/{sheetId} {
      // Lecture : publique, propriétaire, membre du groupe, ou admin
      allow read: if resource.data.isPublic == true ||
                     (request.auth != null && request.auth.uid == resource.data.ownerId) ||
                     (request.auth != null && resource.data.groupId != null && isGroupMember(resource.data.groupId)) ||
                     isAdmin();

      // Listing (pour les requêtes sans filtre côté admin)
      allow list: if isAdmin();

      /**
       * Création : à son propre nom, ou **au nom d'un groupe dont on est membre**.
       *
       * Une grille rattachée à un groupe appartient au groupe, pas à celui qui l'y a
       * mise : `ownerId` porte alors l'identifiant du groupe. Sans cette branche, la
       * copie devait être créée au nom d'une personne, et se retrouvait dans son book
       * à côté de son original. L'appartenance est vérifiée ici, un compte ne peut
       * donc pas se déclarer d'un groupe où il n'est pas.
       */
      allow create: if request.auth != null && (
        request.resource.data.ownerId == request.auth.uid ||
        (request.resource.data.groupId != null &&
         request.resource.data.ownerId == request.resource.data.groupId &&
         isGroupMember(request.resource.data.groupId))
      );

      // Mise à jour : propriétaire, membre du groupe (si groupId défini), admin, OU mise à jour viewCount/rating uniquement
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerId ||
        isAdmin() ||
        (resource.data.groupId != null && isGroupMember(resource.data.groupId)) ||
        (resource.data.isPublic == true &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])) ||
        (resource.data.isPublic == true &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating', 'ratingCount']))
      );

      // Suppression : propriétaire, admin, ou membre du groupe (grilles de groupe)
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.ownerId ||
        isAdmin() ||
        (resource.data.groupId != null && isGroupMember(resource.data.groupId))
      );
    }

    // Commentaires privés sous une grille : conversation à deux entre l'auteur de la
    // grille (ownerId) et une personne qui commente (commenterId). Un « fil » = même
    // (sheetId, commenterId). Lecture/écriture réservées à ces deux personnes ; aucun
    // autre utilisateur ne peut lire le fil (confidentialité stricte).
    match /sheetComments/{commentId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == resource.data.commenterId ||
                      request.auth.uid == resource.data.ownerId);
      allow create: if request.auth != null &&
                       request.resource.data.senderId == request.auth.uid &&
                       request.resource.data.commenterId != request.resource.data.ownerId &&
                       (request.auth.uid == request.resource.data.commenterId ||
                        request.auth.uid == request.resource.data.ownerId) &&
                       request.resource.data.ownerId ==
                         get(/databases/$(database)/documents/sheets/$(request.resource.data.sheetId)).data.ownerId;
      // Chacun peut retirer ses propres messages.
      allow delete: if request.auth != null && request.auth.uid == resource.data.senderId;
    }

    // Notifications in-app : destinataire = userId. Lisibles/effaçables par lui seul ;
    // il ne peut que passer read à true. Création par l'émetteur (fromId == uid).
    match /notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.resource.data.fromId == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Sets (setlists) — toujours privés (owner ou membres du groupe uniquement)
    match /sets/{setId} {
      allow read: if (request.auth != null && request.auth.uid == resource.data.ownerId) ||
                     (request.auth != null && resource.data.groupId != null && isGroupMember(resource.data.groupId)) ||
                     isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth != null &&
                       request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null &&
                               (request.auth.uid == resource.data.ownerId ||
                                (resource.data.groupId != null && isGroupMember(resource.data.groupId)) ||
                                isAdmin());
    }

    // Favoris (bookmarks)
    match /bookmarks/{bookmarkId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == resource.data.userId || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null &&
                       (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Favoris de sets
    match /setBookmarks/{bookmarkId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == resource.data.userId || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null &&
                       (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Bibliothèque d'accords (corrections et ajouts d'un administrateur).
    //
    // Lecture ouverte à tous, y compris sans compte : ce sont des diagrammes affichés
    // publiquement — la bibliothèque et les pages d'accord sont accessibles sans se
    // connecter. Exiger une session y provoquait une erreur de permission à chaque
    // visite anonyme, et privait ces visiteurs des corrections apportées aux doigtés.
    // L'écriture, elle, reste réservée aux administrateurs.
    match /library_chords/{docId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Notes (ratings)
    match /ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
                       (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Groupes de musique
    match /groups/{groupId} {
      // Lecture ouverte aux utilisateurs authentifiés (nécessaire pour le flux
      // d'invitation), et à tous pour un groupe rendu public par son leader.
      //
      // La vitrine /band/{id} est servie par l'Admin SDK et ne dépend pas de cette
      // règle ; on l'ouvre quand même pour que la donnée publique par la page ne
      // soit pas fermée par les règles, incohérence qui se paierait au premier
      // composant client (suivi, aperçu).
      allow read: if resource.data.isPublic == true || request.auth != null;
      allow list: if isAdmin();
      // Création réservée aux comptes Pro (ou admin) - le rejoint d'un groupe existant
      // se fait via /api/groups/join (validation de l'invitation côté serveur)
      allow create: if request.auth != null &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.auth.uid in request.resource.data.memberIds &&
                       (isProUser() || isAdmin());
      allow update: if request.auth != null && (
        isAdmin() ||
        // Leaders peuvent tout modifier
        (request.auth.uid in resource.data.memberIds &&
         resource.data.roles[request.auth.uid] == 'leader') ||
        // Membres peuvent modifier linkedSheetIds et activeConcert
        (request.auth.uid in resource.data.memberIds &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedSheetIds', 'activeConcert', 'updatedAt'])) ||
        // Auto-leave : membre qui se retire lui-même, et seulement lui (personne d'autre retiré/ajouté)
        (request.auth.uid in resource.data.memberIds &&
         !(request.auth.uid in request.resource.data.memberIds) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles', 'updatedAt']) &&
         request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1 &&
         resource.data.memberIds.hasAll(request.resource.data.memberIds))
        // Rejoindre un groupe (auto-join) n'est plus autorisé en écriture directe :
        // cela passe par /api/groups/join, qui utilise les credentials admin après
        // avoir vérifié une invitation valide (existence, expiration, quota d'usages).
      );
      allow delete: if request.auth != null &&
                       (request.auth.uid == resource.data.ownerId || isAdmin());
    }

    // Sessions de concert synchronisé (document ID = setId)
    match /concertSessions/{sessionId} {
      allow read, update, delete: if request.auth != null &&
                                     isGroupMember(resource.data.groupId);
      allow create: if request.auth != null &&
                      isGroupMember(request.resource.data.groupId);
    }

    // Invitations de groupe
    match /groupInvites/{token} {
      allow read: if request.auth != null;
      // Création réservée aux leaders du groupe ciblé (ou admin)
      allow create: if request.auth != null &&
                       request.resource.data.createdBy == request.auth.uid &&
                       (isAdmin() ||
                        (isGroupMember(request.resource.data.groupId) &&
                         get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.roles[request.auth.uid] == 'leader'));
      // Rejoindre un groupe passe désormais par /api/groups/join (credentials admin,
      // qui contournent ces règles) : plus besoin d'update/delete côté client.
      allow update, delete: if isAdmin();
    }

    // Groupe éphémère ("session live") — invités anonymes acceptés (voir auth-context.tsx).
    // Le code (= document ID) fait office de secret partagé, même modèle de confiance
    // que groupInvites : quiconque le connaît peut lire/pousser une grille.
    match /liveSessions/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isProUser() &&
                       request.resource.data.hostId == request.auth.uid;
      allow update: if request.auth != null &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['currentSheetId', 'currentSheetTitle', 'currentSheetArtist',
                                   'pushedBy', 'pushedByName', 'updatedAt']);
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;

      // Présence live : chaque participant (hôte ou invité anonyme) gère son propre
      // document ; tout utilisateur authentifié peut lire la liste des présents.
      match /participants/{participantId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == participantId;
      }
    }

    // Jobs d'analyse audio : lecture par le propriétaire (suivi de progression via
    // onSnapshot). Toutes les écritures passent par le serveur (admin/worker), le
    // client n'écrit jamais directement.
    match /analysisJobs/{jobId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }
  }
}
